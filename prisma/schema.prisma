generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String
  location       String
  sector         String
  city           String         @default("Gurgaon")
  priceInr       Int
  type           String
  status         String
  bedrooms       Int?
  bathrooms      Int?
  areaSqft       Int
  featured       Boolean        @default(false)
  imageUrls      String
  amenities      String
  sourceType     String         @default("ADMIN")
  sourcePlatform String?
  sourceUrl      String?
  priceLastVerified String?
  photoRightsStatus String      @default("OWNER_UPLOADED")
  approvalStatus String         @default("APPROVED")
  boostTier      String         @default("STANDARD")
  leadRoutingMode String        @default("PLATFORM")
  featuredRequested Boolean     @default(false)
  listingContactName String?
  listingContactPhone String?
  listingContactRole String?
  vendorId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  leads          Lead[]

  @@index([location])
  @@index([type])
  @@index([priceInr])
  @@index([featured])
  @@index([approvalStatus])
  @@index([vendorId])
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String
  requirement  String
  propertyId   String?
  routingStatus String @default("PLATFORM")
  sourceChannel String @default("WEBSITE")
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@index([createdAt])
}
